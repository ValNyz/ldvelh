# =============================================================================
# InkRealm — Environment Variables
# Local dev: scripts/dev-setup.sh copies it to .env and generates the secrets.
# Otherwise copy to .env and fill in your values.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://ldvelh:ldvelh@db:5432/ldvelh
DB_PASSWORD=ldvelh                           # Required by docker-compose.yml (no default), URL-safe

# --- Security ---
# Required. The backend refuses to start (even with DEBUG=true) with a secret shorter
# than 32 characters, with leading/trailing whitespace, with fewer than 8 distinct
# characters, containing "change-me", or equal to a value published in this repo.
JWT_SECRET=change-me-to-a-random-64-char-string    # generate with: openssl rand -hex 32
# Absolute session lifetime in hours: a token refresh never extends a session past it.
JWT_SESSION_MAX_HOURS=168
# Reverse proxies in front of the backend that append to X-Forwarded-For (rate-limit
# client IP). docker-compose.yml defaults to 1 (Traefik on Coolify) and the local
# override sets 0 (no proxy: the header is ignored); set it only for another setup.
# Never above the real proxy count: the extra entry would be chosen by the client.
# Cloudflare (proxy mode) in front of Traefik: 2, and only once Traefik trusts the
# Cloudflare ranges (entryPoints forwardedHeaders.trustedIPs), otherwise Traefik drops
# Cloudflare's X-Forwarded-For and every player shares a Cloudflare address.
# TRUSTED_PROXY_HOPS=1
# Required by docker-compose.yml, and by the backend unless DEBUG=true. Fernet key for
# API key encryption: never change it once players have saved keys
# (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# --- LLM API Keys (at least one required) ---
ANTHROPIC_API_KEY=        # Claude (Sonnet/Haiku)
MISTRAL_API_KEY=          # Mistral
WANDB_API_KEY=            # W&B Inference (Qwen)
NEBIUS_API_KEY=           # Nebius
NOUS_API_KEY=             # Nous/Hermes

# --- Email (optional, for verification) ---
RESEND_API_KEY=           # resend.com API key
EMAIL_FROM=noreply@yourdomain.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000    # Local dev: backend URL. Production (same-origin via Traefik): leave empty
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000           # Comma-separated origins

# --- Dev ---
# docker compose takes DEBUG=true and the dev user from docker-compose.override.yml.
# Uncomment only for a bare `uvicorn` run; never on a server (seeds a known-password account).
# DEBUG=true
# DEV_USER_EMAIL=dev@ldvelh.local
# DEV_USER_PASSWORD=devpassword
REGISTRATION_ENABLED=true

# --- Ports (docker-compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
